DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# Empty/unset uses db.sqlite3 in the project directory (SQLite requires no extra driver).
DATABASE_URL=
# PostgreSQL: uv sync --frozen --extra postgres
# DATABASE_URL=postgresql://manualbook:URL_ENCODED_PASSWORD@127.0.0.1:5432/manualbook
# MariaDB: uv sync --frozen --extra mariadb
# DATABASE_URL=mysql://manualbook:URL_ENCODED_PASSWORD@127.0.0.1:3306/manualbook
# SQLite production path (parent directory must be writable by the service user):
# DATABASE_URL=sqlite:////var/lib/manualbook/db.sqlite3
# Generate: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTEGRATION_ENCRYPTION_KEY=
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_TRUST_PROXY=false
DJANGO_SECURE_HSTS_SECONDS=0
# Optional production paths
# DJANGO_STATIC_ROOT=/var/lib/manualbook/staticfiles
# DJANGO_MEDIA_ROOT=/var/lib/manualbook/private_media

# Only list socket IPs of direct proxies that overwrite X-Real-IP.
DJANGO_TRUSTED_PROXY_IPS=
